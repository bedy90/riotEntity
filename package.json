{
  "name": "@bedy90/riotentity",
  "version": "2025.1.3",
  "description": "Bedy90 - Riot Entity",
  "type": "module",
  "module": "build/index.js",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js"
    },
    "./riotentity": {
      "import": "./build/riotentity.js",
      "require": "./build/riotentity.js"
    }
  },
  "scripts": {
    "== Run ==": "",
    "run:test": "npx ts-node src/manual_test.ts",
    "run:testD": "npx ts-node -r tsconfig-paths/register src/manual_test.ts",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "== Generator ==": "",
    "generate:index": "npx rimraf ./generate/interface && npx ts-node scripts/generate-entities-clean.ts index",
    "generate:schema": "npx rimraf ./generate/interface && npx ts-node scripts/generate-entities-clean.ts schema",
    "generate:all": "npm run generate:validator && npm run generate:interfaceIndex",
    "== DEV ==": "",
    "npm:refreshLock": "npm i --package-lock-only",
    "npm:unUsedPackage": "npm prune",
    "npm:cleanDevPackage": "npm prune --production",
    "npm:checkDependecy": "npx depcheck",
    "== Eslint ==": "",
    "eslint": "npx eslint .",
    "eslintFix": "npx eslint . --fix",
    "== 2025 ==": "",
    "publish_dry": "npm publish --dry-run",
    "publish_build_dry": "npm publish ./build --dry-run",
    "build:package": "node scripts/generate-prod-package.cjs",
    "build:tsc": "npx tsc && tsc-alias",
    "build:tsc_rim": "rimraf ./build && tsc",
    "build:full": "rimraf ./build && tsc && tsc-alias && npm run build:package",
    "== TO TEST==": "",
    "testAA": "rimraf ./build && tsc && tsc-alias",
    "build:watch_dev": "tsup --config tsup.config.ts --watch",
    "== 2025 build module ==": "",
    "build:tsup_pack": "tsup --config tsup.config.ts",
    "build:tsup_pack_rim": "rimraf ./build && tsup --config tsup.config.ts && npm run build:package",
    "== 2025 ts-to-zod ==": "",
    "generate:configFile": "node scripts/generateJsonSchema.cjs",
    "generate:ts-to-zod": "npx ts-to-zod",
    "generate:ts-to-zod_conf": "cd scripts && npx ts-to-zod && cd.."
  },
  "files": [
    "build/**/*",
    "changelog.md",
    "readme.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bedy90/riotEntity.git"
  },
  "author": "MBelangerB",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/bedy90/riotEntity/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "homepage": "https://github.com/bedy90/riotEntity#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@jest/globals": "^29.7.0",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.3.1",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "chalk": "^4.1.2",
    "cross-env": "^10.0.0",
    "eslint": "^9.35.0",
    "eslint-define-config": "^2.1.0",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.1",
    "glob": "^11.0.3",
    "globals": "^16.4.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "moment": "^2.30.1",
    "path": "^0.12.7",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "strip-json-comments": "^5.0.3",
    "ts-jest": "^29.4.1",
    "ts-jest-resolver": "^2.0.1",
    "ts-morph": "^25.0.1",
    "ts-node": "^10.9.2",
    "ts-to-zod": "^3.15.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "undici": "^7.16.0"
  },
  "dependencies": {
    "zod": "^4.1.8"
  }
}