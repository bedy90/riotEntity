{
  "name": "@bedy90/riotentity",
  "version": "2025.1.1",
  "description": "Bedy90 - Riot Entity",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./riotentity": {
      "import": "./build/riotentity.js",
      "types": "./build/riotentity.d.ts"
    }
  },
  "scripts": {
    "== Run ==": "",
    "run:test": "npx ts-node src/manual_test.ts",
    "run:testD": "npx ts-node -r tsconfig-paths/register src/manual_test.ts",
    "test": "npx jest --coverage",
    "== Generator ==": "",
    "generate:index": "npx rimraf ./generate/interface && npx ts-node scripts/generate-entities-clean.ts index",
    "generate:schema": "npx rimraf ./generate/interface && npx ts-node scripts/generate-entities-clean.ts schema",
    "generate:all": "npm run generate:validator && npm run generate:interfaceIndex",
    "== DEV ==": "",
    "npm:refreshLock": "npm i --package-lock-only",
    "npm:unUsedPackage": "npm prune",
    "npm:cleanDevPackage": "npm prune --production",
    "== Eslint ==": "",
    "eslint": "npx eslint .",
    "eslintFix": "npx eslint . --fix",
    "== 2025 ==": "",
    "pubish_dry": "npm publish --dry-run",
    "pubish_build_dry": "npm publish ./build --dry-run",
    "build:package": "node scripts/generate-prod-package.js",
    "build:tsc": "npx tsc",
    "build:tsc_rim": "rimraf ./build && tsc",
    "build:full": "rimraf ./build && tsc && npm run build:package",
    "build:tsup_pack": "tsup --config tsup.config.ts"
  },
  "files": [
    "build/**/*",
    "changelog.md",
    "readme.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bedy90/riotEntity.git"
  },
  "author": "MBelangerB",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/bedy90/riotEntity/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "homepage": "https://github.com/bedy90/riotEntity#readme",
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@jest/globals": "^29.7.0",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.3",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "chalk": "^4.1.2",
    "eslint": "^9.25.1",
    "eslint-define-config": "^2.1.0",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.0",
    "glob": "^11.0.2",
    "globals": "^16.1.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "moment": "^2.30.1",
    "path": "^0.12.7",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "strip-json-comments": "^5.0.1",
    "ts-jest": "^29.3.2",
    "ts-morph": "^25.0.1",
    "ts-node": "^10.9.2",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "undici": "^7.8.0"
  },
  "dependencies": {
    "tsconfig-paths": "^4.2.0",
    "zod": "^3.24.4"
  }
}
